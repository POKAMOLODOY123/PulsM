# Лёгкий образ только для запуска REST API инференса (без GPU и Jupyter).
FROM python:3.10-slim

WORKDIR /app

# Только зависимости для API и модели
COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt && rm requirements-api.txt

# Код и конфиг
COPY configs/     ./configs/
COPY src/         ./src/
COPY api/         ./api/
RUN mkdir -p models

# Модель при запуске монтировать: -v /path/to/models:/app/models
# Пример: docker run -p 8000:8000 -v $(pwd)/models:/app/models packing-api
EXPOSE 8000
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
